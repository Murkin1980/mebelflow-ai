{
  "name": "mebelflow-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "build:widget": "node scripts/build-widget.mjs",
    "deploy:widget": "npm run build:widget && wrangler deploy --config apps/widget/wrangler.jsonc",
    "start:api": "node apps/api/server.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check",
    "format": "biome format --write .",
    "check": "npm run build && npm run lint && npm test",
    "demo:build": "esbuild packages/svg-renderer/demo/main.ts --bundle --platform=browser --format=esm --outfile=packages/svg-renderer/demo/dist/main.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.0",
    "three": "^0.185.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.7",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.28.1",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
